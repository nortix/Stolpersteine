        (wd:Q8572 "Landkreis Bad Kreuznach" "deutschland/rheinland-pfalz/landkreis-bad-kreuznach" "")
        (wd:Q8585 "Landkreis Bernkastel-Wittlich" "deutschland/rheinland-pfalz/landkreis-bernkastel-wittlich" "")
        (wd:Q8575 "Landkreis Birkenfeld" "deutschland/rheinland-pfalz/landkreis-birkenfeld" "")
