        (wd:Q6905 "Frankenthal (Pfalz)" "deutschland/rheinland-pfalz/frankenthal-pfalz" "")
        (wd:Q8543 "Landkreis Germersheim" "deutschland/rheinland-pfalz/landkreis-germersheim" "")
        (wd:Q3758 "Kaiserslautern" "deutschland/rheinland-pfalz/kaiserslautern" "")
        (wd:Q8559 "Landkreis Kaiserslautern" "deutschland/rheinland-pfalz/landkreis-kaiserslautern" "")
        (wd:Q3104 "Koblenz" "deutschland/rheinland-pfalz/koblenz" "")
