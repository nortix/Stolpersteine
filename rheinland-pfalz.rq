        (wd:Q8593 "Landkreis Mayen-Koblenz" "deutschland/rheinland-pfalz/landkreis-mayen-koblenz" "")
        (wd:Q4149 "Neustadt an der Weinstraße" "deutschland/rheinland-pfalz/neustadt-an-der-weinstraße" "")
