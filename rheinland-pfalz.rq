#defaultView:Map{"hide":["?id", "?safeName", "?rgb", "?geoshape"]}
#title: Karte aller Verwaltungseinheiten in Rheinland-Pfalz mit Anzahl der erfassten Stolpersteine
SELECT ?id ?name ?geoshape  ?number ?rgb
WHERE {
  VALUES (?id ?name ?safeURL ?number) {
    (wd:Q1200 "Rheinland-Pfalz" "deutschland/rheinland-pfalz" "")
        (wd:Q8596 "Landkreis Ahrweiler" "deutschland/rheinland-pfalz/landkreis-ahrweiler" "")
